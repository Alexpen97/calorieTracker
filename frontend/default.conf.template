server {
  listen ${PORT};
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  location / {
    try_files $uri $uri/ /index.html;
  }

  # Google must redirect to /auth/callback (GET). Recover if Console lists the API path.
  location = /api/auth/google/callback {
    if ($request_method = GET) {
      return 302 /auth/callback$is_args$args;
    }
    proxy_pass http://${GATEWAY_UPSTREAM}/api/auth/google/callback;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location /api/ {
    proxy_pass http://${GATEWAY_UPSTREAM}/api/;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location /.well-known/ {
    proxy_pass http://${GATEWAY_UPSTREAM}/.well-known/;
  }
}
